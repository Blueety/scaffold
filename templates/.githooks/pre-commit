#!/bin/sh
#
# 提交前闸门。检查脚本见 scripts/check-gates.sh。
# 由 init 脚本通过 `git config core.hooksPath .githooks` 启用。
#
# 临时跳过：git commit --no-verify
# 手动全量检查：scripts/check-gates.sh
#
root="$(git -c core.quotepath=false rev-parse --show-toplevel 2>/dev/null)" || exit 0

# ---------------------------------------------------------------------------
# 闸门自身的完整性
#
# 钩子执行的是**工作区**的 check-gates.sh。所以只要能改工作区那份而不动索引，
# 就能「用一个改过的检查器验另一份内容」，而提交进去的仍是原版——事后从历史里
# 完全看不出来。这一段的职责就是把这种状态堵死。
#
# 判据不能用 `git diff --quiet`：它尊重 assume-unchanged / skip-worktree，被标了
# 位的文件改了也不报（实测可绕过）。这里直接比**字节哈希**：索引 blob 对工作区
# 内容（走 clean 过滤器，与哈希索引时同一口径）。
#
# 三个文件都在范围内——钩子自己也是闸门的一部分，改掉它等于关掉闸门。
# ---------------------------------------------------------------------------
bad=""
for f in scripts/check-gates.sh scripts/check-gates.awk .githooks/pre-commit; do
    if ! git -C "$root" ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
        printf '\n提交被拦下：%s 不在索引里（被 git rm --cached 了？）。\n' "$f" >&2
        printf '闸门文件必须随项目一起提交，否则下一个 clone 的项目没有闸门。\n\n' >&2
        exit 1
    fi
    idx="$(git -C "$root" rev-parse --verify --quiet ":$f" 2>/dev/null)"
    cur="$(git -C "$root" hash-object --path="$f" -- "$root/$f" 2>/dev/null)"
    if [ -z "$idx" ] || [ "$idx" != "$cur" ]; then
        printf '\n提交被拦下：%s 的工作区版本与索引不一致。\n' "$f" >&2
        bad=1
    fi
done

if [ -n "$bad" ]; then
    printf '钩子跑的是工作区那份；不暂存就提交等于用改过的检查器验另一份内容。\n' >&2
    printf '把改动 git add 进来，或 git checkout -- scripts/ .githooks/ 恢复原版后重试。\n\n' >&2
    exit 1
fi

exec "$root/scripts/check-gates.sh" --staged
